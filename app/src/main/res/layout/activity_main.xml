<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.ludomax.game.ui.BackdropView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingLeft="32dp"
            android:paddingTop="24dp"
            android:paddingRight="32dp"
            android:paddingBottom="16dp">

            <ImageView
                android:id="@+id/logo"
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:layout_marginTop="12dp"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_title" />

            <TextView
                android:id="@+id/tagline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="18dp"
                android:text="@string/tagline"
                android:textColor="#CFE3FF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnCpu"
                style="@style/MenuButton"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_btn_green"
                android:text="@string/play_cpu" />

            <TextView
                android:id="@+id/btnFriends"
                style="@style/MenuButton"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_btn_blue"
                android:text="@string/play_friends" />

            <TextView
                android:id="@+id/btnHow"
                style="@style/MenuButton"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_btn_orange"
                android:text="@string/how_to_play" />

            <TextView
                android:id="@+id/btnSettings"
                style="@style/MenuButton"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_btn_purple"
                android:text="@string/settings" />

            <TextView
                android:id="@+id/btnShare"
                style="@style/MenuButton"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_btn_red"
                android:text="@string/share_app" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnPrivacy"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_link"
                    android:gravity="center"
                    android:padding="10dp"
                    android:text="@string/privacy_policy"
                    android:textColor="#E3EEFF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btnTerms"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_link"
                    android:gravity="center"
                    android:padding="10dp"
                    android:text="@string/terms"
                    android:textColor="#E3EEFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="#8FA8E8"
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
